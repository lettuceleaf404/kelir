{
  "name": "kelir-api",
  "version": "1.0.0",
  "description": "REST API KELIR (Nusantara Entertainment Hub): Node.js, Express, MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
