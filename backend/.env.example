# Copy this file to .env and fill in the values.

# Port for the API server (Render sets this automatically)
PORT=4000

# MongoDB connection string. Local example: mongodb://127.0.0.1:27017/kelir
# MongoDB Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kelir
MONGODB_URI=mongodb://127.0.0.1:27017/kelir

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of web origins allowed to call the API.
# Use * during local development. Example for production:
# CORS_ORIGINS=https://kelir.vercel.app
CORS_ORIGINS=*

NODE_ENV=development

# Password for admin@kelir.app when running the seed. Set this before seeding a public deployment.
# SEED_ADMIN_PASSWORD=
